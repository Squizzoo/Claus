<?xml version="1.0" encoding="utf-8"?>
<!-- What SignPath signs in the zip the release workflow uploads: the installer and the portable exe, nothing else. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Claus-Setup-*.exe" max-matches="1">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="Claus-*-portable.exe" max-matches="1">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
